# ── Telegram ──────────────────────────────────────────────────────────────
# Get this from @BotFather after creating your bot.
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token

# Public HTTPS URL where the frontend is hosted (Telegram requires HTTPS for
# Mini Apps in production; for local testing use a tunnel, see README).
MINI_APP_URL=https://your-domain.example.com

# ── Backend ───────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=production

# Overridden automatically by docker-compose for the backend/frontend
# containers — only needed if you run services outside Docker.
DATABASE_URL=postgresql://music:music@localhost:5432/music_app

# Secret used to sign session tokens. Change this to a long random string.
JWT_SECRET=change-me-to-a-long-random-string

# Comma-separated Telegram numeric IDs that should be auto-promoted to admin
# the first time they open the app. Find your ID via @userinfobot.
ADMIN_TELEGRAM_IDS=

# ── S3-compatible storage (MinIO by default via docker-compose) ───────────
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=music-app
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_PUBLIC_BASE_URL=http://localhost:9000/music-app

# ── Frontend (build-time) ──────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:4000
# Only used for local dev outside Telegram — leave empty in production.
VITE_DEV_INIT_DATA=
